    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
